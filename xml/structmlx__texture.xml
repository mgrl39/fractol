</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>pixels</parametername>
</parameternamelist>
<parameterdescription>
<para>The literal pixel data. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>bytes_per_pixel</parametername>
</parameternamelist>
<parameterdescription>
<para>The amount of bytes in a pixel, always 4. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
