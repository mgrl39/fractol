<codeline></codeline>
<codeline><highlight class="normal">int32_t<sp/>ft_pixel(int32_t<sp/>r,<sp/>int32_t<sp/>g,<sp/>int32_t<sp/>b,<sp/>int32_t<sp/>a)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
