<codeline></codeline>
<codeline><highlight class="normal">```c</highlight></codeline>
<codeline><highlight class="normal">//<sp/>-----------------------------------------------------------------------------</highlight></codeline>
<codeline><highlight class="normal">//<sp/>Codam<sp/>Coding<sp/>College,<sp/>Amsterdam<sp/>@<sp/>2022-2023<sp/>by<sp/>W2Wizard.</highlight></codeline>
<codeline><highlight class="normal">//<sp/>See<sp/>README<sp/>in<sp/>the<sp/>root<sp/>project<sp/>for<sp/>more<sp/>information.</highlight></codeline>
<codeline><highlight class="normal">//<sp/>-----------------------------------------------------------------------------</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">#include<sp/>&lt;stdio.h&gt;</highlight></codeline>
