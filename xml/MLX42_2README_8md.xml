<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>if<sp/>(mlx_is_key_down(mlx,<sp/>MLX_KEY_UP))</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>image-&gt;instances[0].y<sp/>-=<sp/>5;</highlight></codeline>
