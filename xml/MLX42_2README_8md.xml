<codeline></codeline>
<codeline><highlight class="normal">void<sp/>ft_hook(void*<sp/>param)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>mlx_t*<sp/>mlx<sp/>=<sp/>param;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>if<sp/>(mlx_is_key_down(mlx,<sp/>MLX_KEY_ESCAPE))</highlight></codeline>
