    <briefdescription>
    </briefdescription>
    <detaileddescription>
<para>Key function callback data. Data related to the mlx_key_hook function</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>key</parametername>
</parameternamelist>
<parameterdescription>
<para>The key that was pressed. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>action</parametername>
</parameternamelist>
<parameterdescription>
<para>The action that was done with the key. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>os_key</parametername>
</parameternamelist>
<parameterdescription>
<para>The os_key is unique for every key, and will have a different value/keycode depending on the platform. They may be consistent on different platforms. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>modifier</parametername>
</parameternamelist>
<parameterdescription>
<para>The modifier key that was pressed, 0 if no key was pressed. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
