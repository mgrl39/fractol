\par}
{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 void} calculate_scales_and_limits(t_render_vars *vars, t_data *data)\par
\{\par
    vars->scale[SCALE_X] = 4.0 / (WIDTH * data->zoom);\par
    vars->scale[SCALE_Y] = 4.0 / (HEIGHT * data->zoom);\par
    vars->start[COMPLEX_RE] = -2.0 / data->zoom + data->offset[OFFSET_X];\par
    vars->start[COMPLEX_IM] = -2.0 / data->zoom + data->offset[OFFSET_Y];\par
    vars->pixels = (uint32_t *)data->img->pixels;\par
\}\par
}
\par}
