00223         error = {\cf22 "Julia parameters must be valid numbers."};\par
00224         data.fractal_type = JULIA;\par
00225         data.c[COMPLEX_RE] = ft_atod(argv[2]);\par
00226         data.c[COMPLEX_IM] = ft_atod(argv[3]);\par
00227         {\cf19 if} (data.c[COMPLEX_RE] > INT_MAX || data.c[COMPLEX_RE] < INT_MIN)\par
00228             {\cf19 return} (exit_with_error(error, argv), 1);\par
00229         {\cf19 if} (data.c[COMPLEX_IM] > INT_MAX || data.c[COMPLEX_IM] < INT_MIN)\par
00230             {\cf19 return} (exit_with_error(error, argv), 1);\par
00231     \}\par
00232     {\cf19 else} {\cf19 if} (ft_strcmp(argv[1], {\cf22 "mandelbrot"}) == 0)\par
00233         data.fractal_type = MANDELBROT;\par
