{{\pard\plain \s3\sb240\sa60\keepn\widctlpar\adjustright \b\f1\cgrid 
Definici\'F3n
\par}
{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 void}    render_mandelbrot(t_data *data)\par
\{\par
    t_render_vars   vars;\par
    {\cf18 double}          *precomputed_c_re;\par
    {\cf18 double}          *precomputed_c_im;\par
    {\cf18 int}             y;\par
\par
    calculate_scales_and_limits(&vars, data);\par
    {\cf19 if} (!precompute_coords(&precomputed_c_re, &precomputed_c_im, &vars))\par
        return ;\par
    y = 0;\par
    {\cf19 while} (y < HEIGHT)\par
    \{\par
        vars.c_im = precomputed_c_im[y];\par
        render_mandelbrot_row(&vars, data, y++);\par
    \}\par
    free(precomputed_c_re);\par
    free(precomputed_c_im);\par
\}\par
}
\par}
