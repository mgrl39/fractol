00236     mlx_key_hook(data.mlx, handle_key, &data);\par
00237     mlx_scroll_hook(data.mlx, handle_scroll, &data);\par
00238     mlx_loop(data.mlx);\par
00239     mlx_terminate(data.mlx);\par
00240     {\cf19 return} (EXIT_SUCCESS);\par
00241 \}\par
}
