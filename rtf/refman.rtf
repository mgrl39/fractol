\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid vars->scale[SCALE_X] = 4.0 / (WIDTH * data->zoom);\par
vars->scale[SCALE_Y] = 4.0 / (HEIGHT * data->zoom);\par
}
