{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 int} fr_putstr_fd({\cf18 char} *s, {\cf18 int} fd)\par
\{\par
    {\cf18 int} i;\par
    {\cf18 int} count;\par
\par
    {\cf19 if} (!s)\par
        {\cf19 return} (0);\par
    i = 0;\par
    count = 0;\par
    {\cf19 while} (s[i])\par
        count += write(fd, &s[i++], 1);\par
    {\cf19 return} (count);\par
\}\par
}
\par}
