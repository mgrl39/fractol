00015 {\cf20 /**}\par
00016 {\cf20  * @file mandelbrot.c}\par
00017 {\cf20  * @brief Implementation of the Mandelbrot set rendering.}\par
00018 {\cf20  *}\par
00019 {\cf20  * This file contains all the functions necessary to compute and render the}\par
00020 {\cf20  * Mandelbrot set fractal.}\par
00021 {\cf20  * The Mandelbrot set is a visual representation off a mathematical formula}\par
00022 {\cf20  * applied to complex numbers. THe complexity and beauty of its patterns arise}\par
00023 {\cf20  * from how quickly or slowly each point "escapes" beyond a defined boundary.}\par
00024 {\cf20  *}\par
00025 {\cf20  * ### For Technical Users:}\par
00026 {\cf20  * - **Core Algorithm:** The Mandelbrot set uses the formula `z = z^2 + c`,}\par
00027 {\cf20  *   where:}\par
00028 {\cf20  *   - `z` starts at (0, 0) for every point.}\par
00029 {\cf20  *   - `c` is the complex number corresponding to the pixel's position on the}\par
00030 {\cf20  *   screen.}\par
00031 {\cf20  *   - Iterations continue until `|z|2 > 4` (escape condition) or the maximum}\par
00032 {\cf20  *      number of iterations is reached.}\par
00033 {\cf20  * - **Optimization:**}\par
00034 {\cf20  *   - **Escape Checks:** Early checks prevent unnecessary calculations for}\par
00035 {\cf20  *   points.}\par
00036 {\cf20  *   - **Precomputed Coordinates:** Reduces redundant computations of pixel}\par
00037 {\cf20  *      coordinates.}\par
00038 {\cf20  *   - **Row-Based Rendering:** Processes the fractal row by row for efficient}\par
00039 {\cf20  *      memory and rendering operations.}\par
00040 {\cf20  *   - **Color Mapping:** The number of iteerations determines the color of}\par
00041 {\cf20  *      each pixexl, creating vibrant and intricaate fractal patterns.}\par
00042 {\cf20  *}\par
00043 {\cf20  * ### For Non-Technical Users:}\par
00044 {\cf20  * - **What is the Mandelbrot Set?**}\par
00045 {\cf20  *   The Mandelbrot set is a mathematical design created by repeatedly}\par
00046 {\cf20  *   applying a simple formula to point on a grid. Points that "escape"}\par
00047 {\cf20  *   quickly create bright colors, while points that stay "trapped"}\par
00048 {\cf20  *   generate the darker areas of the fractal.}\par
00049 {\cf20  *}\par
00050 {\cf20  */}{\cf20 }\par
00051 {\cf20 /**}\par
00052 {\cf20  * @brief Computes the next iteration for a single point in the Mandelbrot set.}\par
00053 {\cf20  */}\par
00054 {\cf17 static} {\cf18 void} compute_next_iteration(t_render_vars *vars, {\cf18 int} i)\par
00055 \{\par
00056     {\cf18 double}  temp_z_re;\par
00057 \par
00058     temp_z_re = vars->z_squared[COMPLEX_RE] - vars->z_squared[COMPLEX_IM];\par
00059     temp_z_re += vars->c_re[i];\par
00060     vars->z[COMPLEX_IM] = (2.0 * vars->z[COMPLEX_RE] * vars->z[COMPLEX_IM]);\par
00061     vars->z[COMPLEX_IM] += vars->c_im;\par
00062     vars->z[COMPLEX_RE] = temp_z_re;\par
00063     vars->z_squared[COMPLEX_RE] = vars->z[COMPLEX_RE] * vars->z[COMPLEX_RE];\par
00064     vars->z_squared[COMPLEX_IM] = vars->z[COMPLEX_IM] * vars->z[COMPLEX_IM];\par
00065 \}\par
00066 {\cf20 }\par
00067 {\cf20 /**}\par
00068 {\cf20  * @brief Performs the iterations for a single point in the Mandelbrot set.}\par
00069 {\cf20  */}\par
00070 {\cf17 static} {\cf18 void} mandelbrot_iterations(t_render_vars *vars, {\cf18 int} i)\par
00071 \{\par
00072     {\cf18 double}  current_magnitude_squared;\par
00073     {\cf18 double}  escape_radius_squared;\par
00074 \par
00075     escape_radius_squared = 4.0;\par
00076     vars->z[COMPLEX_RE] = 0.0;\par
00077     vars->z[COMPLEX_IM] = 0.0;\par
00078     vars->z_squared[COMPLEX_RE] = 0;\par
00079     vars->z_squared[COMPLEX_IM] = 0;\par
00080     vars->iterations = 0;\par
00081     {\cf19 while} (1)\par
00082     \{\par
00083         current_magnitude_squared = vars->z_squared[COMPLEX_RE];\par
00084         current_magnitude_squared += vars->z_squared[COMPLEX_IM];\par
00085         {\cf19 if} (vars->iterations >= MAX_ITERATIONS)\par
00086             break ;\par
00087         {\cf19 if} (current_magnitude_squared > escape_radius_squared)\par
00088             break ;\par
00089         compute_next_iteration(vars, i);\par
00090         vars->iterations++;\par
00091     \}\par
00092 \}\par
00093 {\cf20 }\par
00094 {\cf20 /**}\par
00095 {\cf20  * @brief Performs an early scape check for a point in the Mandelbrot set.}\par
00096 {\cf20  */}\par
00097 {\cf17 static} {\cf18 int}  mandelbrot_escape_check(t_render_vars *vars, {\cf18 int} i, t_data *data)\par
00098 \{\par
00099     {\cf18 int}     max_color;\par
00100     {\cf18 double}  dist_sq;\par
00101     {\cf18 double}  esc_chk;\par
00102     {\cf18 double}  bound_condition;\par
00103 \par
00104     max_color = calculate_color(MAX_ITERATIONS);\par
00105     vars->c_re_centered = vars->c_re[i] - 0.25;\par
00106     dist_sq = vars->c_re_centered * vars->c_re_centered;\par
00107     dist_sq += vars->c_im * vars->c_im;\par
00108     esc_chk = dist_sq * (dist_sq + vars->c_re_centered);\par
00109     {\cf19 if} ((data->zoom > 1.0) && (esc_chk < 0.25 * vars->c_im * vars->c_im))\par
00110         {\cf19 return} (vars->row[i] = max_color, 1);\par
00111     bound_condition = (vars->c_re[i] + 1) * (vars->c_re[i] + 1);\par
00112     bound_condition += vars->c_im * vars->c_im;\par
00113     {\cf19 if} (bound_condition < 0.0625)\par
00114         {\cf19 return} (vars->row[i] = max_color, 1);\par
00115     {\cf19 return} (0);\par
00116 \}\par
00117 {\cf20 }\par
00118 {\cf20 /**}\par
00119 {\cf20  * @brief Renders a single row of the Mandelbrot set.}\par
00120 {\cf20  */}\par
00121 {\cf17 static} {\cf18 void} render_mandelbrot_row(t_render_vars *vars, t_data *data, {\cf18 int} y)\par
00122 \{\par
00123     {\cf18 int} x;\par
00124     {\cf18 int} i;\par
00125 \par
00126     x = 0;\par
00127     {\cf19 while} (x < WIDTH)\par
00128     \{\par
00129         vars->row = vars->pixels + (y * WIDTH + x);\par
00130         vars->c_re[0] = vars->start[COMPLEX_RE] + x * vars->scale[SCALE_X];\par
00131         vars->c_re[1] = vars->start[COMPLEX_RE];\par
00132         vars->c_re[1] += (x + 1) * vars->scale[SCALE_X];\par
00133         i = 0;\par
00134         {\cf19 while} (i < 2)\par
00135         \{\par
00136             {\cf19 if} (mandelbrot_escape_check(vars, i, data))\par
00137             \{\par
00138                 i++;\par
00139                 continue ;\par
00140             \}\par
00141             mandelbrot_iterations(vars, i);\par
00142             vars->row[i++] = calculate_color(vars->iterations);\par
00143         \}\par
00144         x += 2;\par
00145     \}\par
00146 \}\par
00147 {\cf20 }\par
00148 {\cf20 /**}\par
00149 {\cf20  * @brief Renders the Mandelbrot set fractal.}\par
00150 {\cf20  */}\par
00151 {\cf18 void}    render_mandelbrot(t_data *data)\par
00152 \{\par
00153     t_render_vars   vars;\par
00154     {\cf18 double}          *precomputed_c_re;\par
00155     {\cf18 double}          *precomputed_c_im;\par
00156     {\cf18 int}             y;\par
00157 \par
00158     calculate_scales_and_limits(&vars, data);\par
00159     {\cf19 if} (!precompute_coords(&precomputed_c_re, &precomputed_c_im, &vars))\par
00160         return ;\par
00161     y = 0;\par
00162     {\cf19 while} (y < HEIGHT)\par
00163     \{\par
00164         vars.c_im = precomputed_c_im[y];\par
00165         render_mandelbrot_row(&vars, data, y++);\par
00166     \}\par
00167     free(precomputed_c_re);\par
00168     free(precomputed_c_im);\par
00169 \}\par
}
