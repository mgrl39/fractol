{{\pard\plain \s3\sb240\sa60\keepn\widctlpar\adjustright \b\f1\cgrid 
Definici\'F3n
\par}
{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 int} calculate_color({\cf18 int} iterations)\par
\{\par
    {\cf18 double}  t;\par
    {\cf18 int}     base_gray;\par
    t_color color;\par
\par
    t = (double)iterations / MAX_ITERATIONS;\par
    base_gray = (30 + 190 * (t * (1 - 0.2 * t)));\par
    color.r = base_gray - (5 * (1 - t) * t * t);\par
    color.g = base_gray - (10 * (1 - t) * (1 - t));\par
    color.b = base_gray - (15 * (1 - t) * t);\par
    {\cf19 return} ((0xFF << 24) | (color.r << 16) | (color.g << 8) | color.b);\par
\}\par
}
\par}
