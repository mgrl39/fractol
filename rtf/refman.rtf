00062 {\cf20 /**}\par
00063 {\cf20  * @brief Performs the iterations for a signle point in the Julia set.}\par
00064 {\cf20  *}\par
00065 {\cf20  * This function applies the Julia set formula iteratively to determine}\par
00066 {\cf20  * whether a given point escapes the threshold. The number of iterations taken}\par
00067 {\cf20  * before escape determines the point's color.}\par
00068 {\cf20  *}\par
00069 {\cf20  * - **Core Algorithm:** The formula `z = z^2 + c` is applied, where:}\par
00070 {\cf20  *   - `z` is a complex number, represented by real (`z_re`) and }\par
00071 {\cf20  *    imaginary (`z_im`) parts.}\par
00072 {\cf20  *   - `c` is a constant defined by the user (real and imaginary parts).}\par
00073 {\cf20  * - **Bounding Condition:** The iteerations stop when:}\par
00074 {\cf20  *   - The sum of the squares of the real and imaginary parts exceeds 4.0.}\par
00075 {\cf20  *   - The maximum number of iterations (`MAX_ITERATIONS`) is reached.}\par
00076 {\cf20  * - **Optimization:** Squared values (`z_re^2` and `z_im^2`) are cached}\par
00077 {\cf20  *   to avoid redundant calculations.}\par
00078 {\cf20  *}\par
00079 {\cf20  * @param vars Pointer to the structure holding rendering variables}\par
00080 {\cf20  *  (e.g., `z` and `iterations`).}\par
00081 {\cf20  * @params data Pointer to the main fractal data, including the Julia}\par
00082 {\cf20  *  constant (`c`).}\par
00083 {\cf20  */}\par
00084 {\cf17 static} {\cf18 void} julia_iterations(t_render_vars *vars, t_data *data)\par
00085 \{\par
00086     {\cf18 double}  temp_z_re;\par
00087 \par
00088     vars->iterations = 0;\par
00089     {\cf19 while} (vars->z_squared[COMPLEX_RE] + vars->z_squared[COMPLEX_IM] <= 4.0 && \\\par
00090             vars->iterations < MAX_ITERATIONS)\par
00091     \{\par
00092         temp_z_re = vars->z_squared[COMPLEX_RE];\par
00093         temp_z_re -= vars->z_squared[COMPLEX_IM];\par
00094         temp_z_re += data->c[COMPLEX_RE];\par
00095         vars->z[COMPLEX_IM] = 2.0 * vars->z[COMPLEX_RE] * \\\par
00096             vars->z[COMPLEX_IM] + data->c[COMPLEX_IM];\par
00097         vars->z[COMPLEX_RE] = temp_z_re;\par
00098         vars->z_squared[COMPLEX_RE] = vars->z[COMPLEX_RE] * vars->z[COMPLEX_RE];\par
00099         vars->z_squared[COMPLEX_IM] = vars->z[COMPLEX_IM] * vars->z[COMPLEX_IM];\par
00100         vars->iterations++;\par
00101     \}\par
00102 \}\par
00103 {\cf20 }\par
00104 {\cf20 /**}\par
00105 {\cf20  * @brief Renders a single row of the Julia set.}\par
00106 {\cf20  *}\par
