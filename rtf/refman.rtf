{\tc\tcl2 \v 4. render_mandelbrot_row}
{\bkmkstart AAAAAAAAKC}
{\bkmkend AAAAAAAAKC}
{{\pard\plain \s3\sb240\sa60\keepn\widctlpar\adjustright \b\f1\cgrid 
Definici\'F3n
\par}
{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf17 static} {\cf18 void} render_mandelbrot_row(t_render_vars *vars, t_data *data, {\cf18 int} y)\par
\{\par
    {\cf18 int} x, i;\par
\par
    x = 0;\par
    {\cf19 while} (x < WIDTH)\par
    \{\par
        vars->row = vars->pixels + (y * WIDTH + x);\par
        vars->c_re[0] = vars->start[COMPLEX_RE] + x * vars->scale[SCALE_X];\par
        vars->c_re[1] = vars->start[COMPLEX_RE] + (x + 1) * vars->scale[SCALE_X];\par
        i = 0;\par
        {\cf19 while} (i < 2)\par
        \{\par
            {\cf19 if} (mandelbrot_escape_check(vars, i, data))\par
            \{\par
                i++;\par
                continue ;\par
            \}\par
            mandelbrot_iterations(vars, i);\par
            vars->row[i++] = calculate_color(vars->iterations);\par
        \}\par
        x += 2;\par
    \}\par
\}\par
}
\par}
{\bkmkstart AAAAAAAAKD}
{\bkmkend AAAAAAAAKD}
