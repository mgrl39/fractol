{\tc\tcl3 \v Definici\'F3n}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf17 static} {\cf18 int}  is_valid_number({\cf17 const} {\cf18 char} *str)\par
\{\par
    {\cf18 int} i;\par
    {\cf18 int} valid_status[2];\par
\par
    i = 0;\par
    valid_status[HAS_DIGIT] = 0;\par
    valid_status[HAS_POINT] = 0;\par
    {\cf19 while} (str[i] == 32 || (str[i] >= 9 && str[i] <= 13))\par
        i++;\par
    {\cf19 if} (str[i] == {\cf23 '-'} || str[i] == {\cf23 '+'})\par
        i++;\par
    {\cf19 while} (str[i] >= {\cf23 '0'} && str[i] <= {\cf23 '9'})\par
    \{\par
        valid_status[HAS_DIGIT] = 1;\par
        i++;\par
    \}\par
    {\cf19 if} (str[i] == {\cf23 '.'})\par
    \{\par
        valid_status[HAS_POINT] = 1;\par
        i++;\par
    \}\par
    {\cf19 if} (valid_status[HAS_POINT] && (str[i] < {\cf23 '0'} || str[i] > {\cf23 '9'}))\par
        {\cf19 return} (0);\par
    {\cf19 while} (str[i] >= {\cf23 '0'} && str[i] <= {\cf23 '9'})\par
        i++;\par
    {\cf19 return} (valid_status[HAS_DIGIT] && str[i] == {\cf23 '\\0'});\par
\}\par
}
\par}
