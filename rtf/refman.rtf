\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 void} render_julia(t_data *data)\par
\{\par
    t_render_vars vars;\par
    {\cf18 int} y;\par
\par
    calculate_scales_and_limits(&vars, data);\par
    y = 0;\par
    {\cf19 while} (y < HEIGHT)\par
    \{\par
        vars.c_im = vars.start[COMPLEX_IM] + y * vars.scale[SCALE_Y];\par
        render_julia_row(&vars, data, y++);\par
    \}\par
\}\par
}
