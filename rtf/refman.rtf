00149 {\cf20 }\par
00150 {\cf20 /**}\par
00151 {\cf20  * @brief Initializes the MLX42 rendering environment.}\par
00152 {\cf20  *}\par
00153 {\cf20  * This function sets up the environment for rendering fractals by:}\par
00154 {\cf20  * - Creating an MLX42 window with thee given title.}\par
00155 {\cf20  * - Allocating an image buffer for rendering.}\par
00156 {\cf20  * - Setting initial offsets and zoom level for the fractal.}\par
00157 {\cf20  *}\par
00158 {\cf20  * If Julia set parameters (`c[COMPLEX_RE]` or `c[COMPLEX_IM]`) are outside}\par
00159 {\cf20  * the range [-2.0, 2.0], it issues a warning about potential visual effects.}\par
00160 {\cf20  * The function terminates the program in case of initialization failures.}\par
00161 {\cf20  *}\par
00162 {\cf20  * @param data Pointer to the data structure containing fractal information,}\par
00163 {\cf20  *  offsets, zoom, and MLX42 resources.}\par
00164 {\cf20  * @param argv Array of argument strings, where argv[1] is used as the window }\par
00165 {\cf20  * title.}\par
00166 {\cf20  */}\par
00167 {\cf17 static} {\cf18 void} initialize_window(t_data *data, {\cf18 char} *argv[])\par
00168 \{\par
00169     {\cf19 if} ((data->c[COMPLEX_RE] > 2.0 || data->c[COMPLEX_RE] < -2\par
00170             || data->c[COMPLEX_IM] > 2.0 || data->c[COMPLEX_IM] < -2))\par
00171     \{\par
00172         fr_putstr_fd(LIGHT_GOLD {\cf22 "Warning: The values for Julia are"}, 1);\par
00173         fr_putstr_fd({\cf22 " outside the common range [-2.0, 2.0]\\n"}, 1);\par
00174         fr_putstr_fd(RESET {\cf22 "This may produce unusual or"}, 1);\par
00175         fr_putstr_fd({\cf22 " less interesting fractals.\\n"}, 1);\par
00176     \}\par
00177     data->mlx = mlx_init(WIDTH, HEIGHT, argv[1], {\cf17 false});\par
00178     {\cf19 if} (!data->mlx)\par
00179         exit (EXIT_FAILURE);\par
00180     data->img = mlx_new_image(data->mlx, WIDTH, HEIGHT);\par
00181     {\cf19 if} (!data->img)\par
00182     \{\par
00183         mlx_terminate(data->mlx);\par
00184         exit (EXIT_FAILURE);\par
00185     \}\par
00186     {\cf19 if} (mlx_image_to_window(data->mlx, data->img, 0, 0) == -1)\par
00187     \{\par
00188         mlx_terminate(data->mlx);\par
00189         exit (EXIT_FAILURE);\par
00190     \}\par
00191     data->offset[OFFSET_X] = 0.0;\par
00192     data->offset[OFFSET_Y] = 0.0;\par
00193     data->zoom = 1.0;\par
00194 \}\par
00195 {\cf20 }\par
00196 {\cf20 /**}\par
00197 {\cf20  * @brief Main entry point for the fractal rendering program.}\par
00198 {\cf20  *}\par
00199 {\cf20  * This function orchestrates the entire fractal rendering process by:}\par
00200 {\cf20  * - Validating the command-line arguments to ensure correct fractal type}\par
00201 {\cf20  *   and parameters.}\par
00202 {\cf20  * - Initializing the fractal type, including Julia parameters if applicable.}\par
00203 {\cf20  * - Setting up the MLX42 rendering environment, including the window}\par
00204 {\cf20  *   and image buffer.}\par
00205 {\cf20  * - Rendering the chosen fractal based on the input parameters.}\par
00206 {\cf20  * - Configuring event hooks for used interaction (keyboard and scroll events).}\par
00207 {\cf20  * - Starting the main event loop for continuous interaction and updates.}\par
00208 {\cf20  *}\par
00209 {\cf20  * @param argc Number of arguments passed to the program.}\par
00210 {\cf20  * @param argv Array of argument strings, including the program name and input }\par
00211 {\cf20  *  parameters.}\par
00212 {\cf20  * @return Returns `EXIT_SUCCESS` on successful execution, }\par
00213 {\cf20  *  or terminates on error.}\par
00214 {\cf20  */}\par
00215 {\cf18 int} main({\cf18 int} argc, {\cf18 char} *argv[])\par
00216 \{\par
00217     t_data  data;\par
00218     {\cf18 char}    *error;\par
00219 \par
00220     validate_arguments(argc, argv);\par
