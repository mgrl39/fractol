{\tc\tcl3 \v 5.2 Renderizaci\'F3n del fractal}
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 void} render_fractal(t_data *data)\par
\{\par
    {\cf19 if} (data->fractal_type == JULIA)\par
        render_julia(data);\par
    {\cf19 else} {\cf19 if} (data->fractal_type == MANDELBROT)\par
        render_mandelbrot(data);\par
\}\par
}
 \par
