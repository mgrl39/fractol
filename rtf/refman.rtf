00147 {\cf20  *}\par
00148 {\cf20  * This function handles the full rendering process for the Julia set by}\par
00149 {\cf20  * iterating through all rows of the screen, rendering each row sequentially.}\par
00150 {\cf20  *}\par
00151 {\cf20  * - **Setup:**}\par
00152 {\cf20  *   - Calculates the scaling and starting coordinates based on the zoom level}\par
00153 {\cf20  *      and positional offsets provided by the user.}\par
00154 {\cf20  * - **Row-by-Row Rendering:**}\par
00155 {\cf20  *   - For each row on the screen (`y` coordinate), the corresponding imaginary}\par
00156 {\cf20  *      coordinate is computed.}\par
00157 {\cf20  *   - The row is passed to `render_julia_row`, which handles the pixel-by-pixel}\par
00158 {\cf20  *   rendering.}\par
00159 {\cf20  * - **Full Image Construction:**}\par
00160 {\cf20  *   - The ffunction processes every row until the entire fractal is rendered.}\par
00161 {\cf20  *}\par
00162 {\cf20  * @param data Pointer to the main fractal data structure, including rendering}\par
00163 {\cf20  *  details such as zoom, offsets, and fractal paarameters.}\par
00164 {\cf20  */}\par
00165 {\cf18 void}    render_julia(t_data *data)\par
00166 \{\par
00167     t_render_vars   vars;\par
00168     {\cf18 int}             y;\par
00169 \par
00170     calculate_scales_and_limits(&vars, data);\par
00171     y = 0;\par
00172     {\cf19 while} (y < HEIGHT)\par
00173     \{\par
00174         vars.c_im = vars.start[COMPLEX_IM] + y * vars.scale[SCALE_Y];\par
00175         render_julia_row(&vars, data, y++);\par
00176     \}\par
00177 \}\par
}
