{\bkmkstart AAAAAAAAIN}
{\bkmkend AAAAAAAAIN}
{{\pard\plain \s4\sb240\sa60\keepn\widctlpar\adjustright \b\f1\fs20\cgrid 
La funci\'F3n handle_key:
\par}
{\tc\tcl4 \v La funci\'F3n handle_key:}
Esta es la implementaci\'F3n personalizada de la funci\'F3n de callback que procesa los eventos de teclado: {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf18 void}    handle_key(mlx_key_data_t keydata, {\cf18 void} *param)\par
\{\par
    t_data  *data;\par
\par
    data = (t_data *)param;\par
    {\cf19 if} (keydata.key == MLX_KEY_ESCAPE)\par
        mlx_close_window(data->mlx);\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_W)\par
        data->offset[OFFSET_Y] -= 0.1 / data->zoom;\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_S)\par
        data->offset[OFFSET_Y] += 0.1 / data->zoom;\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_A)\par
        data->offset[OFFSET_X] -= 0.1 / data->zoom;\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_D)\par
        data->offset[OFFSET_X] += 0.1 / data->zoom;\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_UP)\par
        data->zoom *= ZOOM_IN;\par
    {\cf19 else} {\cf19 if} (keydata.key == MLX_KEY_DOWN)\par
        data->zoom *= ZOOM_OUT;\par
    render_fractal(data);\par
\}\par
}
\par}
