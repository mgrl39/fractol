00015 {\cf20 /**}\par
00016 {\cf20  * @file calcs.c}\par
00017 {\cf20  * @brief Core calculations for fractal rendering.}\par
00018 {\cf20  *}\par
00019 {\cf20  * This file contains the functions responsible for performing the core}\par
00020 {\cf20  * calculations required to render fractals. It handles:}\par
00021 {\cf20  * - Scaling and positioning the fractal within the rendering window.}\par
00022 {\cf20  * - Precomputing the coordinates ffor each pixel to optimize rendering}\par
00023 {\cf20  *   performance.}\par
00024 {\cf20  * - Rendering the fractal by delegating to specific algorithms}\par
00025 {\cf20  *   (Julia or Mandelbrot).}\par
00026 {\cf20  * - Mapping iteration counts to colors for visually representing }\par
00027 {\cf20  *   fractal complexity.}\par
00028 {\cf20  *}\par
00029 {\cf20  *   For non-technical users:}\par
00030 {\cf20  *   - This file performs the "math magic" that powers the fractal visuals,}\par
00031 {\cf20  *      calculating where and howw the fractal is drawn and colored on }\par
00032 {\cf20  *      the screen.}\par
00033 {\cf20  */}\par
00034 {\cf20 }\par
00035 {\cf20 /**}\par
00036 {\cf20  * @brief Calculates the scales and starting points for the fractal rendering.}\par
00037 {\cf20  *}\par
00038 {\cf20  * This function determines how the fractal is scaled and positioned on the}\par
00039 {\cf20  * screen.}\par
00040 {\cf20  * It computes the scale factors for each pixel and establishes the}\par
00041 {\cf20  * starting points ffor the real and imaginary part of the fractal based on the}\par
00042 {\cf20  * zoom level and offsets.}\par
00043 {\cf20  *}\par
00044 {\cf20  * For non-technical users:}\par
00045 {\cf20  * - Think of it as setting the "zoom" and "pam" for the fractal to display it}\par
00046 {\cf20  *   correctly on the screen.}\par
00047 {\cf20  *}\par
00048 {\cf20  * @param vars Pointer to the rendering variables structure.}\par
00049 {\cf20  * @param data Pointer to the main data structure containing fractal }\par
00050 {\cf20  *  information.}\par
00051 {\cf20  */}\par
00052 {\cf18 void}    calculate_scales_and_limits(t_render_vars *vars, t_data *data)\par
00053 \{\par
00054     vars->scale[SCALE_X] = 4.0 / (WIDTH * data->zoom);\par
00055     vars->scale[SCALE_Y] = 4.0 / (HEIGHT * data->zoom);\par
00056     vars->start[COMPLEX_RE] = -2.0 / data->zoom + data->offset[OFFSET_X];\par
00057     vars->start[COMPLEX_IM] = -2.0 / data->zoom + data->offset[OFFSET_Y];\par
00058     vars->pixels = (uint32_t *)data->img->pixels;\par
00059 \}\par
00060 {\cf20 }\par
00061 {\cf20 /**}\par
00062 {\cf20  * @brief Precomputes the coordinates for each pixel in the fractal.}\par
00063 {\cf20  *}\par
00064 {\cf20  * This function calculates the real and imaginary parts of the fractal for}\par
00065 {\cf20  * each pixel on the screen, storing them in arrays for quick access during}\par
00066 {\cf20  * rendering.}\par
00067 {\cf20  * It ensures that every point is prepared for the fractal calculations.}\par
00068 {\cf20  *}\par
00069 {\cf20  * For non-technical users:}\par
00070 {\cf20  * - Imagine this as creating a "grid" of points where the fractal will be}\par
00071 {\cf20  *   drawn. This points tell the program where to caalculate the colors.}\par
00072 {\cf20  *}\par
00073 {\cf20  * @param c_re Pointer to the array storing real coordinates.}\par
00074 {\cf20  * @param c_im Pointer to the array storing imaginary coordinates.}\par
00075 {\cf20  * @param vars Pointer to the rendering variables structure.}\par
00076 {\cf20  * @return Returns 1 on success, or 0 if memory allocation fails.}\par
00077 {\cf20  */}\par
00078 {\cf18 int} precompute_coords({\cf18 double} **c_re, {\cf18 double} **c_im, t_render_vars *vars)\par
00079 \{\par
00080     {\cf18 int} i;\par
00081 \par
00082     *c_re = ({\cf18 double} *)malloc(WIDTH * {\cf17 sizeof}({\cf18 double}));\par
00083     *c_im = ({\cf18 double} *)malloc(HEIGHT * {\cf17 sizeof}({\cf18 double}));\par
00084     {\cf19 if} (!(*c_re) || !(*c_im))\par
00085         {\cf19 return} (free(*c_re), free(*c_im), 0);\par
00086     i = -1;\par
00087     {\cf19 while} (++i < WIDTH)\par
00088         (*c_re)[i] = vars->start[COMPLEX_RE] + i * vars->scale[SCALE_X];\par
00089     i = -1;\par
00090     {\cf19 while} (++i < HEIGHT)\par
00091         (*c_im)[i] = vars->start[COMPLEX_IM] + i * vars->scale[SCALE_Y];\par
00092     {\cf19 return} (1);\par
00093 \}\par
00094 {\cf20 }\par
00095 {\cf20 /**}\par
00096 {\cf20  * @brief Renders the chosen fractal on the screen.}\par
00097 {\cf20  *}\par
00098 {\cf20  * This function selects the appropiate rendering algorithm based on the fractal}\par
00099 {\cf20  * type chosen by the user (Julia or Mandelbrot) and renders it on the screen.}\par
00100 {\cf20  *}\par
00101 {\cf20  * For non-technical users:}\par
00102 {\cf20  *  - Depending on the type of fractal (Julia or Mandelbrot), this function}\par
00103 {\cf20  *  draws the chosen fractal pattern for you to see.}\par
00104 {\cf20  *}\par
00105 {\cf20  * @param data Pointer to the main data structure containing fractal and}\par
00106 {\cf20  * rendering details.}\par
00107 {\cf20  */}\par
00108 {\cf18 void}    render_fractal(t_data *data)\par
00109 \{\par
00110     {\cf19 if} (data->fractal_type == JULIA)\par
00111         render_julia(data);\par
00112     {\cf19 else} {\cf19 if} (data->fractal_type == MANDELBROT)\par
00113         render_mandelbrot(data);\par
00114 \}\par
00115 {\cf20 }\par
00116 {\cf20 /**}\par
00117 {\cf20  * @brief Calculates the color of a pixel based on how many iterations it takes}\par
00118 {\cf20  * to "escape".}\par
00119 {\cf20  *}\par
00120 {\cf20  * This function determines the color of each pixel in the fractal by mapping}\par
00121 {\cf20  * the iteration count (how many steps we are needed to reach a threshold)}\par
00122 {\cf20  * to a color gradient.}\par
00123 {\cf20  *}\par
00124 {\cf20  * For non-technical users:}\par
00125 {\cf20  * - The function decides the color of each pooint in the fractal, creating the}\par
00126 {\cf20  *   beautiful patterns you see based on how "complex" the point is.}\par
00127 {\cf20  *}\par
00128 {\cf20  * @param iterations Number of iterations required for the opint to "escape".}\par
00129 {\cf20  * @return Returns the calculated color as an integer.}\par
00130 {\cf20  */}\par
00131 {\cf18 int} calculate_color({\cf18 int} iterations)\par
00132 \{\par
00133     {\cf18 double}  it_count;\par
00134     {\cf18 int}     base_gray;\par
00135     t_color color;\par
00136 \par
00137     it_count = (double)iterations / MAX_ITERATIONS;\par
00138     base_gray = (30 + 190 * (it_count * (1 - 0.2 * it_count)));\par
00139     color.r = base_gray - (5 * (1 - it_count) * it_count * it_count);\par
00140     color.g = base_gray - (10 * (1 - it_count) * (1 - it_count));\par
00141     color.b = base_gray - (15 * (1 - it_count) * it_count);\par
00142     {\cf19 return} ((0xFF << 24) | (color.r << 16) | (color.g << 8) | color.b);\par
00143 \}\par
}
