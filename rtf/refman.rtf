00108 {\cf20  * through each pixel, applying the Juliaa set formula, and determining its}\par
00109 {\cf20  * color.}\par
00110 {\cf20  *}\par
00111 {\cf20  * - **Coordinate Mapping:**}\par
00112 {\cf20  *   - Each pixel is mapped to a complex number (`z`) based on its position}\par
00113 {\cf20  *      and the scaling factors calculated from the zoom and offsets.}\par
00114 {\cf20  * - **Iteration and Coloring:**}\par
00115 {\cf20  *   - The Julia set formula is applied iteratively for each pixel.}\par
00116 {\cf20  *   - The number of iterations is used to calculate the pixel's color.}\par
00117 {\cf20  * - **Row Processing:** Each pixel in the row is processed sequentially,}\par
00118 {\cf20  *   and the result is stored in the image buffer.}\par
00119 {\cf20  *}\par
00120 {\cf20  * @param vars Pointer to the rendering variables structure (e.g., pixel and}\par
00121 {\cf20  *  scaling).}\par
00122 {\cf20  * @param data Pointer to the main fractal data.}\par
00123 {\cf20  * @param y The current row index being processed (0 for the first row, up to}\par
00124 {\cf20  * `HEIGHT - 1`).}\par
00125 {\cf20  */}\par
00126 {\cf17 static} {\cf18 void} render_julia_row(t_render_vars *vars, t_data *data, {\cf18 int} y)\par
00127 \{\par
00128     {\cf18 int} x;\par
00129 \par
00130     x = 0;\par
00131     {\cf19 while} (x < WIDTH)\par
00132     \{\par
00133         vars->c_re[0] = vars->start[COMPLEX_RE] + x * vars->scale[SCALE_X];\par
00134         vars->z[COMPLEX_RE] = vars->c_re[0];\par
00135         vars->z[COMPLEX_IM] = vars->c_im;\par
00136         vars->z_squared[COMPLEX_RE] = vars->z[COMPLEX_RE] * vars->z[COMPLEX_RE];\par
00137         vars->z_squared[COMPLEX_IM] = vars->z[COMPLEX_IM] * vars->z[COMPLEX_IM];\par
00138         julia_iterations(vars, data);\par
00139         vars->row = vars->pixels + y * WIDTH + x;\par
00140         *vars->row = calculate_color(vars->iterations);\par
00141         x++;\par
00142     \}\par
00143 \}\par
